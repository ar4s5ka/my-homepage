---
import { ClientRouter } from 'astro:transitions';
import { socialLinks } from '../data/socialLinks';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Home" } = Astro.props;
---
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('js-reveal');
			}
		</script>
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&family=JetBrains+Mono:wght@400;600&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
	</head>
	<body>
		<div class="network-bg" transition:persist aria-hidden="true"></div>

		<svg class="nn-diagram" transition:persist aria-hidden="true" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
			<g class="nn-edges">
				<line x1="40" y1="40.0" x2="200" y2="20.0" />
				<line x1="40" y1="40.0" x2="200" y2="85.0" />
				<line x1="40" y1="40.0" x2="200" y2="150.0" />
				<line x1="40" y1="40.0" x2="200" y2="215.0" />
				<line x1="40" y1="40.0" x2="200" y2="280.0" />
				<line x1="40" y1="113.0" x2="200" y2="20.0" />
				<line x1="40" y1="113.0" x2="200" y2="85.0" />
				<line x1="40" y1="113.0" x2="200" y2="150.0" />
				<line x1="40" y1="113.0" x2="200" y2="215.0" />
				<line x1="40" y1="113.0" x2="200" y2="280.0" />
				<line x1="40" y1="187.0" x2="200" y2="20.0" />
				<line x1="40" y1="187.0" x2="200" y2="85.0" />
				<line x1="40" y1="187.0" x2="200" y2="150.0" />
				<line x1="40" y1="187.0" x2="200" y2="215.0" />
				<line x1="40" y1="187.0" x2="200" y2="280.0" />
				<line x1="40" y1="260.0" x2="200" y2="20.0" />
				<line x1="40" y1="260.0" x2="200" y2="85.0" />
				<line x1="40" y1="260.0" x2="200" y2="150.0" />
				<line x1="40" y1="260.0" x2="200" y2="215.0" />
				<line x1="40" y1="260.0" x2="200" y2="280.0" />
				<line x1="200" y1="20.0" x2="360" y2="70.0" />
				<line x1="200" y1="20.0" x2="360" y2="150.0" />
				<line x1="200" y1="20.0" x2="360" y2="230.0" />
				<line x1="200" y1="85.0" x2="360" y2="70.0" />
				<line x1="200" y1="85.0" x2="360" y2="150.0" />
				<line x1="200" y1="85.0" x2="360" y2="230.0" />
				<line x1="200" y1="150.0" x2="360" y2="70.0" />
				<line x1="200" y1="150.0" x2="360" y2="150.0" />
				<line x1="200" y1="150.0" x2="360" y2="230.0" />
				<line x1="200" y1="215.0" x2="360" y2="70.0" />
				<line x1="200" y1="215.0" x2="360" y2="150.0" />
				<line x1="200" y1="215.0" x2="360" y2="230.0" />
				<line x1="200" y1="280.0" x2="360" y2="70.0" />
				<line x1="200" y1="280.0" x2="360" y2="150.0" />
				<line x1="200" y1="280.0" x2="360" y2="230.0" />
			</g>
			<g class="nn-nodes">
				<circle cx="40" cy="40.0" r="4" style="animation-delay: 0.1s" />
				<circle cx="40" cy="113.0" r="4" style="animation-delay: 0.4s" />
				<circle cx="40" cy="187.0" r="4" style="animation-delay: 0.7s" />
				<circle cx="40" cy="260.0" r="4" style="animation-delay: 1.0s" />
				<circle cx="200" cy="20.0" r="4" style="animation-delay: 1.3s" />
				<circle cx="200" cy="85.0" r="4" style="animation-delay: 1.6s" />
				<circle cx="200" cy="150.0" r="4" style="animation-delay: 1.9s" />
				<circle cx="200" cy="215.0" r="4" style="animation-delay: 2.2s" />
				<circle cx="200" cy="280.0" r="4" style="animation-delay: 2.5s" />
				<circle cx="360" cy="70.0" r="4" style="animation-delay: 2.8s" />
				<circle cx="360" cy="150.0" r="4" style="animation-delay: 3.1s" />
				<circle cx="360" cy="230.0" r="4" style="animation-delay: 3.4s" />
			</g>
		</svg>

		<div class="formula-bg" transition:persist aria-hidden="true">
			<span class="formula">y = Wx + b</span>
			<span class="formula">σ(x) = 1 / (1 + e⁻ˣ)</span>
			<span class="formula">∂L/∂w</span>
			<span class="formula">∇θ J(θ)</span>
			<span class="formula">argmin L(θ)</span>
			<span class="formula">ReLU(x) = max(0, x)</span>
			<span class="formula">softmax(zᵢ)</span>
			<span class="formula">Σ wᵢxᵢ + b</span>
		</div>

		<header transition:persist>
			<div class="logo">
				<span class="logo-node"></span>
				<span class="logo-text">{title}</span>
			</div>
			<nav>
				<a href="/">Home</a>
				<a href="/blog">Blog</a>
				<a href="/about">About</a>
			</nav>
		</header>

		<main transition:animate="fade">
			<slot />
		</main>

		<footer transition:persist>
			<div class="social-links">
				{socialLinks.map((link) => (
					<a href={link.href} target="_blank" rel="noopener noreferrer" class="social-link">
						{link.name}
					</a>
				))}
			</div>
			<p class="copyright">© 2026 ar4suka</p>
		</footer>

		<script>
			function initNNPulses() {
				const svg = document.querySelector<SVGSVGElement>('.nn-diagram');
				if (!svg || (window as any).__nnPulseInit) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				(window as any).__nnPulseInit = true;

				const svgNS = 'http://www.w3.org/2000/svg';
				const pulseLayer = document.createElementNS(svgNS, 'g');
				pulseLayer.setAttribute('class', 'nn-pulses');
				svg.appendChild(pulseLayer);

				const allEdges = Array.from(svg.querySelectorAll('.nn-edges line'));
				const groups = [
					allEdges.filter((l) => l.getAttribute('x1') === '40'),
					allEdges.filter((l) => l.getAttribute('x1') === '200'),
				];

				function firePulse(line: Element) {
					const x1 = parseFloat(line.getAttribute('x1') || '0');
					const y1 = parseFloat(line.getAttribute('y1') || '0');
					const x2 = parseFloat(line.getAttribute('x2') || '0');
					const y2 = parseFloat(line.getAttribute('y2') || '0');
					const dot = document.createElementNS(svgNS, 'circle');
					dot.setAttribute('r', '2.5');
					dot.setAttribute('class', 'nn-pulse-dot');
					pulseLayer.appendChild(dot);
					const duration = 650 + Math.random() * 300;
					const start = performance.now();
					function step(now: number) {
						const t = Math.min(1, (now - start) / duration);
						dot.setAttribute('cx', String(x1 + (x2 - x1) * t));
						dot.setAttribute('cy', String(y1 + (y2 - y1) * t));
						dot.setAttribute('opacity', String(t > 0.85 ? (1 - t) / 0.15 : 1));
						if (t < 1) requestAnimationFrame(step);
						else dot.remove();
					}
					requestAnimationFrame(step);
				}

				let layerIndex = 0;
				function pulseWave() {
					const group = groups[layerIndex % groups.length];
					group.forEach((line) => {
						if (Math.random() < 0.45) {
							setTimeout(() => firePulse(line), Math.random() * 250);
						}
					});
					layerIndex++;
					setTimeout(pulseWave, 1300);
				}
				pulseWave();
			}

			function initParallax() {
				if ((window as any).__parallaxInit) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				(window as any).__parallaxInit = true;

				window.addEventListener('mousemove', (e) => {
					const diagram = document.querySelector<HTMLElement>('.nn-diagram');
					const formula = document.querySelector<HTMLElement>('.formula-bg');
					const relX = e.clientX / window.innerWidth - 0.5;
					const relY = e.clientY / window.innerHeight - 0.5;
					if (diagram) diagram.style.transform = `translate(${relX * -14}px, ${relY * -14}px)`;
					if (formula) formula.style.transform = `translate(${relX * -6}px, ${relY * -6}px)`;
				});
			}

			function initScrollReveal() {
				if (!document.documentElement.classList.contains('js-reveal')) return;
				const items = Array.from(document.querySelectorAll<HTMLElement>('main .card, main .post-item'));
				if (!items.length) return;

				const prevObserver = (window as any).__revealObserver as IntersectionObserver | undefined;
				if (prevObserver) prevObserver.disconnect();

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const el = entry.target as HTMLElement;
							el.classList.add('is-revealed');
							el.addEventListener('transitionend', () => { el.style.transitionDelay = ''; }, { once: true });
							observer.unobserve(el);
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
				);
				(window as any).__revealObserver = observer;

				items.forEach((el, i) => {
					el.style.transitionDelay = `${(i % 6) * 70}ms`;
					observer.observe(el);
				});
			}

			initNNPulses();
			initParallax();
			initScrollReveal();
			document.addEventListener('astro:page-load', () => {
				initNNPulses();
				initParallax();
				initScrollReveal();
			});
		</script>
	</body>
</html>

<style>
	:root {
		--bg-color: #0b0f1a;
		--surface-color: #131a2b;
		--text-color: #dbe4f0;
		--text-muted: #7c8aa5;
		--accent: #5eead4;
		--accent-2: #a78bfa;
		--node-color: rgba(94, 234, 212, 0.5);
		--edge-color: rgba(167, 139, 250, 0.15);
	}

	* {
		box-sizing: border-box;
	}

	body {
		position: relative;
		max-width: 760px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		font-family: "Zen Kaku Gothic New", sans-serif;
		line-height: 1.8;
		color: var(--text-color);
		background-color: var(--bg-color);
		overflow-x: hidden;
	}

	/* --- ニューラルネットワーク風の背景(ノード + エッジ) --- */
	.network-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		background-color: var(--bg-color);
		background-image:
			radial-gradient(circle at 15% 20%, var(--node-color) 0, transparent 2px),
			radial-gradient(circle at 85% 15%, var(--node-color) 0, transparent 2px),
			radial-gradient(circle at 40% 40%, var(--node-color) 0, transparent 2px),
			radial-gradient(circle at 70% 55%, var(--node-color) 0, transparent 2px),
			radial-gradient(circle at 20% 75%, var(--node-color) 0, transparent 2px),
			radial-gradient(circle at 90% 80%, var(--node-color) 0, transparent 2px),
			radial-gradient(circle at 55% 90%, var(--node-color) 0, transparent 2px),
			linear-gradient(135deg, var(--edge-color) 1px, transparent 1px),
			linear-gradient(45deg, var(--edge-color) 1px, transparent 1px);
		background-size:
			100% 100%, 100% 100%, 100% 100%, 100% 100%,
			100% 100%, 100% 100%, 100% 100%,
			60px 60px, 60px 60px;
		animation: pulse 6s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 0.6; }
		50% { opacity: 1; }
	}

	/* --- 全結合ニューラルネットワーク図(装飾) --- */
	.nn-diagram {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		opacity: 0.4;
		transition: transform 0.3s ease-out;
		will-change: transform;
	}

	.nn-edges line {
		stroke: var(--edge-color);
		stroke-width: 0.6;
	}

	.nn-nodes circle {
		fill: var(--node-color);
		animation: node-pulse 4s ease-in-out infinite;
	}

	@keyframes node-pulse {
		0%, 100% { opacity: 0.35; r: 3; }
		50% { opacity: 1; r: 4.5; }
	}

	.nn-pulse-dot {
		fill: var(--accent);
		filter: drop-shadow(0 0 3px var(--accent));
	}

	/* --- 数式が漂う背景装飾 --- */
	.formula-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		transition: transform 0.3s ease-out;
		will-change: transform;
	}

	.formula {
		position: absolute;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.85rem;
		color: var(--accent);
		opacity: 0.12;
		white-space: nowrap;
		animation: drift 22s ease-in-out infinite alternate;
	}

	.formula:nth-child(1) { top: 8%; left: 6%; animation-delay: 0s; }
	.formula:nth-child(2) { top: 18%; left: 78%; animation-delay: -3s; color: var(--accent-2); }
	.formula:nth-child(3) { top: 82%; left: 12%; animation-delay: -6s; }
	.formula:nth-child(4) { top: 92%; left: 70%; animation-delay: -9s; color: var(--accent-2); }
	.formula:nth-child(5) { top: 40%; left: 85%; animation-delay: -12s; }
	.formula:nth-child(6) { top: 55%; left: 3%; animation-delay: -15s; color: var(--accent-2); }
	.formula:nth-child(7) { top: 4%; left: 45%; animation-delay: -18s; }
	.formula:nth-child(8) { top: 70%; left: 45%; animation-delay: -20s; color: var(--accent-2); }

	@keyframes drift {
		0% { transform: translate(0, 0) rotate(0deg); }
		100% { transform: translate(10px, -14px) rotate(2deg); }
	}

	@media (max-width: 640px) {
		.nn-diagram,
		.formula-bg {
			display: none;
		}
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: "JetBrains Mono", monospace;
		font-weight: 600;
	}

	/* Persona風: 初回ロード時だけ一瞬走るグリッチフラッシュ */
	@keyframes glitch-flash {
		0% { text-shadow: 2px 0 var(--accent), -2px 0 var(--accent-2); transform: translateX(0); }
		20% { text-shadow: -3px 0 var(--accent), 3px 0 var(--accent-2); transform: translateX(-2px); }
		40% { text-shadow: 3px 0 var(--accent-2), -3px 0 var(--accent); transform: translateX(2px); }
		60% { text-shadow: -1px 0 var(--accent), 1px 0 var(--accent-2); transform: translateX(0); }
		100% { text-shadow: none; transform: translateX(0); }
	}

	.logo-text {
		display: inline-block;
		animation: glitch-flash 0.5s steps(2, end) 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-text {
			animation: none;
		}
	}

	.logo-node {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px 2px var(--accent);
	}

	nav {
		display: flex;
		gap: 1.5rem;
	}

	nav a {
		position: relative;
		display: inline-block;
		color: var(--text-muted);
		text-decoration: none;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.9rem;
		padding-bottom: 0.2rem;
		transition: color 0.2s ease, transform 0.08s ease-out;
	}

	/* Persona風: 下線ではなく斜めの光の筋がホバーで走る */
	nav a::after {
		content: "";
		position: absolute;
		left: -15%;
		right: -15%;
		bottom: -2px;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--accent) 45%, var(--accent-2) 65%, transparent);
		transform: skewX(-25deg) scaleX(0);
		transform-origin: left center;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	nav a:hover {
		color: var(--accent);
	}

	nav a:hover::after {
		transform: skewX(-25deg) scaleX(1);
	}

	nav a:active {
		transform: scale(0.94);
	}

	main {
		background-color: var(--surface-color);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(94, 234, 212, 0.03);
		padding: 2rem;
		margin-top: 1.5rem;
	}

	main :global(a) {
		color: var(--accent);
	}

	main :global(code) {
		font-family: "JetBrains Mono", monospace;
		background: rgba(255, 255, 255, 0.06);
		padding: 0.1rem 0.35rem;
		border-radius: 4px;
	}

	/* --- Persona風の見出し: 斜めのアクセントスラッシュ + わずかな傾き --- */
	main :global(h1) {
		position: relative;
		display: inline-block;
		font-family: "JetBrains Mono", monospace;
		font-weight: 700;
		padding: 0.15em 0.75em 0.15em 0.55em;
		margin: 0 0 0.25em -0.1em;
		transform: rotate(-1.5deg);
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	main :global(h1)::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(100deg, var(--accent-2), var(--accent));
		clip-path: polygon(0% 0%, 100% 0%, 94% 100%, 0% 100%);
		opacity: 0.16;
	}

	main :global(h1:hover) {
		transform: rotate(0deg);
	}

	@media (prefers-reduced-motion: reduce) {
		main :global(h1) {
			transition: none;
		}
	}

	/* --- カードグリッド(ページ側から使う共通コンポーネント) --- */
	main :global(.card-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	main :global(.card) {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 10px;
		padding: 1.25rem;
		transition: border-color 0.2s ease, transform 0.2s ease, opacity 0.5s ease,
			translate 0.55s cubic-bezier(0.22, 1, 0.36, 1), scale 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			rotate 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}

	main :global(.card:hover) {
		border-color: rgba(94, 234, 212, 0.35);
		transform: translateY(-2px);
	}

	main :global(.card:active) {
		transform: scale(0.97);
		transition-duration: 0.08s;
	}

	/* --- スクロールリビール(カード/リストアイテム共通) ---
	   :root.js-revealが初期HTMLパース時点で同期的に付与されるため、
	   JS未実行のまま最初のフレームが描画される(=中身が消えたまま固まる)ことはない。
	   translate/scale/rotateは`transform`(hover/activeで使用中)とは独立したCSSプロパティなので、
	   ホバー時の見た目と干渉しない。また`clip-path`と違いIntersectionObserverの可視率計算に
	   影響しない(clip-pathで隠すと「隠れているせいで交差率が閾値を超えず、永遠に表示されない」
	   というデッドロックが起きたため、この方式に変更した)。 */
	:global(html.js-reveal) main :global(.card),
	:global(html.js-reveal) main :global(.post-item) {
		opacity: 0;
		translate: 0 18px;
		scale: 0.94;
		rotate: -3deg;
	}

	:global(html.js-reveal) main :global(.card.is-revealed),
	:global(html.js-reveal) main :global(.post-item.is-revealed) {
		opacity: 1;
		translate: 0 0;
		scale: 1;
		rotate: 0deg;
	}

	main :global(.card-wide) {
		grid-column: 1 / -1;
	}

	main :global(.card-title) {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-left: 0.7rem;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.95rem;
		color: var(--accent);
		margin: 0 0 0.75rem;
	}

	/* Persona風: タイトル左に斜めのアクセントティック */
	main :global(.card-title)::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.15em;
		bottom: 0.15em;
		width: 4px;
		background: linear-gradient(180deg, var(--accent), var(--accent-2));
