---
import Layout from '../layouts/Layout.astro';
import PlatformLink from '../components/PlatformLink.astro';
import { socialLinks } from '../data/socialLinks';
import { blogPosts } from '../data/blogPosts';
import { friendLinks } from '../data/friendLinks';

const githubUsername = 'ar4s5ka';
const latestPost = blogPosts[0];
---

<Layout title="Home | ほめぱげ">
	<h1>Hello world!</h1>
	<p>あらすかのホームページへようこそ</p>

	<section class="card-grid">
		<div class="card card-wide gh-contrib-card">
			<h2 class="card-title">GitHub Contributions</h2>
			<img
				src={`https://ghchart.rshah.org/${githubUsername}`}
				alt={`${githubUsername} の GitHub contributions`}
				loading="lazy"
			/>
		</div>

		<div class="card">
			<h2 class="card-title">SNS</h2>
			<div class="platform-link-list">
				{socialLinks.map((link) => (
					<PlatformLink platform={link.icon} label={link.name} href={link.href} />
				))}
			</div>
		</div>

		<div class="card">
			<h2 class="card-title">最新の記事</h2>
			{latestPost && (
				<>
					<PlatformLink platform={latestPost.platform} label={latestPost.title} href={latestPost.url} />
					<p><a href="/blog">Blog を見る →</a></p>
				</>
			)}
		</div>

		<div class="card">
			<h2 class="card-title">今やってること / 学習ログ</h2>
			<ul>
				<li>ディープラーニングについて学んでいます。</li>
				<li>ローカルLLMを作ることが目標です</li>
				<li>ハッカソン出場したい</li>
			</ul>
		</div>

		<div class="card card-wide">
			<h2 class="card-title">リンク集</h2>
			<ul class="friend-link-list">
				{friendLinks.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="friend-link">
							<img
								src={`https://www.google.com/s2/favicons?domain=${new URL(link.url).hostname}&sz=32`}
								alt=""
								class="friend-favicon"
								width="16"
								height="16"
								loading="lazy"
							/>
							<span class="friend-name">{link.name}</span>
							{link.description && <span class="friend-desc">{link.description}</span>}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.platform-link-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.card p {
		margin-top: 0.6rem;
	}

	.friend-link-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0.6rem;
	}

	.friend-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.75rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 8px;
		text-decoration: none;
		color: var(--text-color);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.friend-link:hover {
		border-color: rgba(94, 234, 212, 0.35);
		transform: translateY(-2px);
	}

	.friend-favicon {
		flex-shrink: 0;
		border-radius: 3px;
	}

	.friend-name {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.88rem;
	}

	.friend-desc {
		font-size: 0.78rem;
		color: var(--text-muted);
	}
</style>
