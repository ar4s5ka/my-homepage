---
import Layout from '../layouts/Layout.astro';
import PlatformLink from '../components/PlatformLink.astro';
import { socialLinks } from '../data/socialLinks';
import { blogPosts } from '../data/blogPosts';
import { friendLinks } from '../data/friendLinks';

const githubUsername = 'ar4s5ka';
const latestPost = blogPosts[0];
---

<Layout title="Home | ほめぱげ">
	<h1>Hello world!</h1>
	<p>あらすかのホームページへようこそ</p>

	<section class="card-grid">
		<div class="card card-wide gh-contrib-card">
			<h2 class="card-title">GitHub Contributions</h2>
			<img
				src={`https://ghchart.rshah.org/ar4s5ka`}
				alt={`ar4s5kaの GitHub contributions`}
				loading="lazy"
			/>
		</div>

		<div class="card">
			<h2 class="card-title">SNS</h2>
			<div class="platform-link-list">
				{socialLinks.map((link) => (
					<PlatformLink platform={link.icon} label={link.name} href={link.href} />
				))}
			</div>
		</div>

		<div class="card">
			<h2 class="card-title">最新の記事</h2>
			{latestPost && (
				<>
					<PlatformLink platform={latestPost.platform} label={latestPost.title} href={latestPost.url} />
					<p><a href="/blog">Blog を見る →</a></p>
				</>
			)}
		</div>

		<div class="card">
			<h2 class="card-title">今やってること / 学習ログ</h2>
			<ul>
				<li>ディープラーニングについて学んでいます。</li>
				<li>ローカルLLMを作ることが目標です</li>
				<li>ハッカソン出場したい</li>
			</ul>
		</div>

		<div class="card card-wide">
			<h2 class="card-title">リンク集</h2>
			<ul class="friend-link-list">
				{friendLinks.map((link) => {
					const hostname = new URL(link.url).hostname;
					const primaryFavicon = link.icon ?? `https://icons.duckduckgo.com/ip3/${hostname}.ico`;
					const fallbackFavicon = link.icon ? undefined : `https://www.google.com/s2/favicons?domain=${hostname}&sz=32`;
					return (
						<li>
							<a href={link.url} target="_blank" rel="noopener noreferrer" class="friend-link" title={link.description}>
								<span class="friend-favicon-wrap">
									<img
										src={primaryFavicon}
										alt=""
										class="friend-favicon"
										width="20"
										height="20"
										loading="lazy"
										data-fallback={fallbackFavicon}
									/>
								</span>
								<span class="friend-text">
									<span class="friend-name">{link.name}</span>
									{link.description && <span class="friend-desc">{link.description}</span>}
								</span>
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</section>

	<script>
		// icons.duckduckgo.com / google の favicon 取得元は、favicon が見つからない場合でも
		// 200扱いで汎用プレースホルダー画像を返すことがある(HTTPステータスは404でも<img>は普通に読み込める)。
		// そのため onerror では検知できず、既知のプレースホルダーのサイズ(ddg: 48x48, google: 16x16)で判定する。
		function initFriendFavicons() {
			document.querySelectorAll<HTMLImageElement>('.friend-favicon').forEach((img) => {
				const isPlaceholder = () => {
					// サイト自身から解決できた本物のfaviconにはこの判定を適用しない(誤検知防止)。
					if (img.src.includes('icons.duckduckgo.com')) {
						return img.naturalWidth === 48 && img.naturalHeight === 48;
					}
					if (img.src.includes('google.com/s2/favicons')) {
						return img.naturalWidth === 16 && img.naturalHeight === 16;
					}
					return false;
				};
				const advance = () => {
					const fallback = img.dataset.fallback;
					if (fallback) {
						delete img.dataset.fallback;
						img.src = fallback;
					} else {
						img.style.visibility = 'hidden';
					}
				};
				const check = () => {
					if (img.complete && img.naturalWidth > 0 && isPlaceholder()) advance();
				};
				img.addEventListener('load', check);
				img.addEventListener('error', advance);
				check();
			});
		}

		initFriendFavicons();
		document.addEventListener('astro:page-load', initFriendFavicons);
	</script>
</Layout>

<style>
	.platform-link-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.card p {
		margin-top: 0.6rem;
	}

	.friend-link-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.5rem;
	}

	.friend-link-list li {
		margin: 0;
	}

	.friend-link {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		padding: 0.45rem 0.6rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 8px;
		text-decoration: none;
		color: var(--text-color);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.friend-link:hover {
		border-color: rgba(94, 234, 212, 0.35);
		transform: translateY(-2px);
	}

	.friend-link:active {
		transform: scale(0.97);
		transition-duration: 0.08s;
	}

	.friend-favicon-wrap {
		flex-shrink: 0;
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.friend-favicon {
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 3px;
	}

	.friend-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.35;
	}

	.friend-name {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.85rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.friend-desc {
		font-size: 0.72rem;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
